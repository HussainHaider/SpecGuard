# Copy to .env and fill in. Never commit .env — non-negotiable #8.

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=specguard
POSTGRES_PASSWORD=specguard
POSTGRES_DB=specguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://specguard:specguard@localhost:5432/specguard

# arq's broker. See docs/decisions.md 013 — this supersedes the Postgres job queue.
REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=eu_food_law

# --- LLM provider -----------------------------------------------------------
# One of: openai | anthropic | fake. OpenAI is the provider this project runs on;
# `fake` replays recorded fixtures and is what tests and CI use, so no test can reach a
# live API. Leave this as `fake` unless you are deliberately making real calls.
LLM_PROVIDER=fake
# Applies to OpenAI only. Current Claude models removed the sampling parameters and
# reject temperature outright; see docs/decisions.md 007.
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=
# Confirm against your own account: `uv run --project api python -c \
#   "from openai import OpenAI; print([m.id for m in OpenAI().models.list()])"`
OPENAI_MODEL=gpt-4.1

# --- Embeddings (fastembed, local ONNX — no API calls) -----------------------
# fastembed 0.8 does not ship intfloat/multilingual-e5-small; see docs/decisions.md 005.
# The alternative is intfloat/multilingual-e5-large (1024 dims, 2.24 GB), which turns the
# e5 passage:/query: prefixes on automatically.
DENSE_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
EMBEDDING_CACHE_DIR=.cache/fastembed

# --- Corpus -----------------------------------------------------------------
# Feeds every chunk_id. Bumping it re-indexes and invalidates stored citations.
CORPUS_VERSION=2024-11-01
CORPUS_DIR=corpus
# Synthetic specs and the pre-computed reports demo mode replays. compose overrides both
# of these with absolute paths, because inside the image there is no repository root to
# resolve a relative path against.
FIXTURES_DIR=fixtures

# --- Retrieval / abstention thresholds --------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_PREFETCH_K=50
MIN_RETRIEVAL_SCORE=0.35
MIN_EXTRACTION_CONFIDENCE=0.60

# --- Tracing ----------------------------------------------------------------
# Off unless both of the first two are set. With tracing off, nothing in the process
# imports the langsmith client or touches the network — which is what keeps the default
# test run offline.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=specguard
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# The dataset evals/sync_langsmith.py pushes the golden set into. The JSONL files in
# evals/golden/ are the source of truth; this is a projection of them.
LANGSMITH_DATASET=specguard-golden

# --- Evaluation -------------------------------------------------------------
# The model that judges tier 2's open-ended output. Pinned rather than left to deepeval's
# default: a judged number is only comparable against another number from the same judge.
# Tier 2 is reported, never merge-blocking (non-negotiable #6).
JUDGE_MODEL=gpt-4.1

# --- n8n (self-hosted, community edition) ------------------------------------
# n8n encrypts saved credentials with this key. If it is not set, n8n generates one
# into its volume on first start — and every credential saved under the old key becomes
# permanently unreadable after a volume reset or a fresh clone. compose refuses to start
# without it for exactly that reason.
# Generate your own: `openssl rand -hex 32`. Replace this before deploying anywhere.
N8N_ENCRYPTION_KEY=dev-only-key-replace-me-0000000000000000000000000000000000000000
# Schedule triggers fire in this zone; the weekly regulation watcher depends on it.
GENERIC_TIMEZONE=Europe/Berlin
N8N_HOST=localhost
N8N_PORT=5678
# What n8n advertises as a node's callback address. Wrong here gives you a webhook URL
# that looks correct in the editor and resolves to nothing.
WEBHOOK_URL=http://localhost:5678/
# Where the intake workflow drops compliant specs and posts failures.
INTAKE_WATCH_DIR=/workflows/intake/inbox
INTAKE_ARCHIVE_DIR=/workflows/intake/archive
INTAKE_FAILURE_WEBHOOK=

# --- App --------------------------------------------------------------------
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
# Where the /ops page's "open the LangSmith project" link points.
VITE_LANGSMITH_URL=https://smith.langchain.com
# Origins the API accepts browser requests from. The review UI in development.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
GRAPH_VERSION=graph@v1

# Serve pre-computed reports from fixtures/reports instead of running the graph. Zero
# LLM calls, zero embedding calls, no Qdrant and no worker. This is what the public
# deployment runs, and the UI labels every report as replayed.
DEMO_MODE=false
# Basic auth on the deployed instance only; leave blank locally.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
