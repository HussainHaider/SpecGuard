# Copy to .env and fill in. Never commit .env — non-negotiable #8.

# --- Datastores -------------------------------------------------------------
POSTGRES_USER=specguard
POSTGRES_PASSWORD=specguard
POSTGRES_DB=specguard
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://specguard:specguard@localhost:5432/specguard

QDRANT_URL=http://localhost:6333
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=
QDRANT_COLLECTION=eu_food_law

# --- LLM provider -----------------------------------------------------------
# One of: anthropic | openai | fake. Tests and CI use `fake` and never leave the process.
LLM_PROVIDER=fake
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2
LLM_TIMEOUT_S=60

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# --- Embeddings (fastembed, local ONNX — no API calls) -----------------------
DENSE_EMBEDDING_MODEL=intfloat/multilingual-e5-small
SPARSE_EMBEDDING_MODEL=Qdrant/bm25
EMBEDDING_CACHE_DIR=.cache/fastembed

# --- Corpus -----------------------------------------------------------------
# Feeds every chunk_id. Bumping it re-indexes and invalidates stored citations.
CORPUS_VERSION=2024-11-01
CORPUS_DIR=corpus

# --- Retrieval / abstention thresholds --------------------------------------
RETRIEVAL_TOP_K=8
RETRIEVAL_PREFETCH_K=25
MIN_RETRIEVAL_SCORE=0.35
MIN_EXTRACTION_CONFIDENCE=0.60

# --- Tracing ----------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=specguard
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- App --------------------------------------------------------------------
API_PORT=8000
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO
GRAPH_VERSION=graph@v1
# Basic auth on the deployed instance only; leave blank locally.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
